# Ignore invisible
.*
*~
!.gitignore
!.markdownlint-cli2.jsonc
coverage/
!.github

# Host-local recovery artefacts (Issue #211). run.sh now writes these outside
# docs/, but a host still running an older run.sh writes them here — and the
# heartbeat stages the whole docs/ tree, so ignore them explicitly.
docs/index.json.bak
docs/index.json.corrupted.*
# Staging files stranded in docs/ by an interrupted older run.sh
*.log.tmp.*
